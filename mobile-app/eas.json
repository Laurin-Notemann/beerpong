{
    "cli": {
        "version": ">= 16.18.1",
        "appVersionSource": "remote"
    },
    "build": {
        "development": {
            "developmentClient": true,
            "distribution": "internal",
            "channel": "development",
            "environment": "development",
            "env": {
                "SENTRY_DISABLE_AUTO_UPLOAD": "true"
            }
        },
        "preview": {
            "distribution": "internal",
            "channel": "preview",
            "environment": "preview",
            "autoIncrement": true,
            "android": {
                "buildType": "apk"
            }
        },
        "production": {
            "distribution": "store",
            "channel": "production",
            "environment": "production",
            "autoIncrement": true
        }
    },
    "submit": {
        "production": {
            "ios": {
                "ascAppId": "6738529626",
                "appleTeamId": "A5X77AGYX4"
            }
        }
    }
}
