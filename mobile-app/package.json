{
    "name": "mobile-app",
    "main": "expo-router/entry",
    "version": "1.0.93",
    "scripts": {
        "prestart": "cp ../.env.example .env",
        "start": "expo start",
        "reset-project": "node ./scripts/reset-project.js",
        "android": "expo run:android",
        "ios": "expo run:ios",
        "web": "expo start --web",
        "test": "vitest .",
        "eslint": "expo lint",
        "typecheck": "tsc --noEmit",
        "lint": "npm run eslint && npm run typecheck",
        "build:ios:local": "npx eas build --local --platform ios",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "gen-types": "npx openapicmd typegen  ./api/generated/openapi.json > openapi/openapi.d.ts",
        "ci:format": "npm run format:check",
        "ci:lint": "npm run lint",
        "ci:test": "TEST_ENV=CI npm run test"
    },
    "dependencies": {
        "@expo/metro-runtime": "~58.0.10",
        "@expo/vector-icons": "^15.0.3",
        "@legendapp/list": "^3.6.0",
        "@openspacelabs/react-native-zoomable-view": "^2.4.2",
        "@react-native-async-storage/async-storage": "^2.1.0",
        "@react-native-community/datetimepicker": "9.2.1",
        "@react-native-community/netinfo": "12.0.1",
        "@react-navigation/drawer": "^7.14.3",
        "@react-navigation/native": "^7.5.0",
        "@sentry/react-native": "^8.29.0",
        "@tanstack/query-async-storage-persister": "^5.60.5",
        "@tanstack/react-query": "^5.60.5",
        "@tanstack/react-query-persist-client": "^5.60.5",
        "axios": "^1.7.7",
        "babel-preset-expo": "~58.0.0",
        "dayjs": "^1.11.13",
        "expo": "^58.0.2",
        "expo-application": "~58.0.3",
        "expo-blur": "~58.0.3",
        "expo-camera": "~58.0.7",
        "expo-clipboard": "~58.0.3",
        "expo-constants": "~58.0.9",
        "expo-crypto": "~58.0.4",
        "expo-dev-client": "~58.0.10",
        "expo-file-system": "~58.0.5",
        "expo-font": "~58.0.5",
        "expo-haptics": "~58.0.4",
        "expo-image": "~58.0.10",
        "expo-image-manipulator": "~58.0.11",
        "expo-image-picker": "~58.0.10",
        "expo-jwt": "^1.8.2",
        "expo-linking": "~58.0.10",
        "expo-notifications": "~58.0.11",
        "expo-router": "~58.0.12",
        "expo-secure-store": "~58.0.2",
        "expo-splash-screen": "~58.0.4",
        "expo-status-bar": "~58.0.3",
        "expo-system-ui": "~58.0.5",
        "expo-updates": "~58.0.13",
        "expo-web-browser": "~58.0.4",
        "openapi-client-axios": "^7.5.5",
        "openapi-client-axios-typegen": "^7.7.0",
        "openapicmd": "^2.6.1",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "react-native": "0.88.0-rc.3",
        "react-native-confirmation-code-field": "^7.4.0",
        "react-native-draggable-flatlist": "^4.0.1",
        "react-native-drawer-layout": "^4.2.11",
        "react-native-gesture-handler": "~3.2.1",
        "react-native-insta-pagination-dots": "^1.0.5",
        "react-native-pager-view": "9.0.4",
        "react-native-portalize": "^1.0.7",
        "react-native-reanimated": "4.7.0",
        "react-native-root-toast": "^3.6.0",
        "react-native-safe-area-context": "~5.9.1",
        "react-native-screens": "~4.28.0",
        "react-native-svg": "15.15.5",
        "react-native-vector-icons": "^10.2.0",
        "react-native-web": "^0.21.2",
        "react-native-worklets": "0.13.0",
        "text-encoding": "^0.7.0",
        "zustand": "^5.0.1"
    },
    "devDependencies": {
        "@babel/core": "^7.29.7",
        "@testing-library/react": "^16.0.1",
        "@trivago/prettier-plugin-sort-imports": "^4.3.0",
        "@types/react": "~19.3.0",
        "@types/react-native-vector-icons": "^6.4.18",
        "@types/react-test-renderer": "^18.0.7",
        "@types/text-encoding": "^0.0.39",
        "eslint": "^8.57.0",
        "eslint-config-expo": "~58.0.4",
        "husky": "^9.1.7",
        "jsdom": "^25.0.1",
        "prettier": "^3.3.3",
        "react-test-renderer": "19.1.0",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.14.0",
        "vitest": "^2.1.5"
    },
    "private": true,
    "expo": {
        "install": {
            "exclude": [
                "@sentry/react-native"
            ]
        }
    }
}
