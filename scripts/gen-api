#!/bin/bash
# Regenerates the app's API types from apps/api/openapi/openapi.json. The copy
# lives here, not in package.json: scripts are part of the app's runtime
# fingerprint.
set -e
cp apps/api/openapi/openapi.json apps/mobile/api/generated/openapi.json
pnpm --filter mobile-app run gen-types
pnpm exec oxfmt apps/mobile/api/generated/openapi.json apps/mobile/openapi/openapi.d.ts
