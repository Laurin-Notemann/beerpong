{
  "include": [
    "src",
    "vite.config.ts",
    "aliases.ts"
  ],
  "compilerOptions": {
    "strict": true,
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2022"
    ],
    "types": [
      "vite/client",
      "node"
    ],
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "allowJs": false,
    "paths": {
      "~/*": [
        "./src/*"
      ],
      "@/*": [
        "../mobile-app/*"
      ]
    }
  }
}
