# db
POSTGRES_USER=admin
POSTGRES_PASSWORD=password
POSTGRES_DB_NAME=beerpong
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# backend
API_BASE_URL=http://localhost:8080/
JWT_SECRET=SomeVeryLongRandomSecretKeyWhichIsUsedToEncodeJwtTokensForAuthorization

# sentry (leave empty locally; staging/prod DSNs live on the server and in EAS env vars)
BACKEND_SENTRY_DSN=

# s3
AWS_REGION=eu-central-1
AWS_BUCKET_NAME=versus-bucket
# without https://
AWS_ENDPOINT=foobarbaz.your-objectstorage.com
AWS_ACCESS_KEY=access-key
AWS_SECRET_KEY=secret-key

# Apple push key (.p8, base64-encoded) for Live Activities and the widget; empty: no pushes.
# Local and development builds have sandbox tokens: set APNS_PRODUCTION=false for them.
APNS_KEY_ID=
APNS_KEY=
APNS_PRODUCTION=true
