{
    "$schema": "https://turborepo.com/schema.json",
    "extends": ["//"],
    "tasks": {
        "typecheck": {
            "dependsOn": ["build"],
            "inputs": [
                "$TURBO_DEFAULT$",
                "$TURBO_ROOT$/apps/mobile/lib/**",
                "$TURBO_ROOT$/apps/mobile/api/utils/**",
                "$TURBO_ROOT$/apps/mobile/components/CupGrid/**",
                "$TURBO_ROOT$/apps/mobile/utils/**",
                "$TURBO_ROOT$/apps/mobile/openapi/**"
            ]
        },
        "test": {
            "inputs": [
                "$TURBO_DEFAULT$",
                "$TURBO_ROOT$/apps/mobile/lib/**",
                "$TURBO_ROOT$/apps/mobile/api/utils/**",
                "$TURBO_ROOT$/apps/mobile/components/CupGrid/**",
                "$TURBO_ROOT$/apps/mobile/utils/**",
                "$TURBO_ROOT$/apps/mobile/openapi/**"
            ]
        },
        "build": {
            "outputs": [".output/**", "public/tv/polyfills.js", "src/routeTree.gen.ts"],
            "inputs": [
                "$TURBO_DEFAULT$",
                "!src/routeTree.gen.ts",
                "$TURBO_ROOT$/apps/mobile/lib/**",
                "$TURBO_ROOT$/apps/mobile/api/utils/**",
                "$TURBO_ROOT$/apps/mobile/components/CupGrid/**",
                "$TURBO_ROOT$/apps/mobile/utils/**",
                "$TURBO_ROOT$/apps/mobile/openapi/**"
            ]
        }
    }
}
