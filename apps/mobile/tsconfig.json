{
    "extends": "expo/tsconfig.base.json",
    "compilerOptions": {
        "strict": true,
        "paths": {
            "@/*": ["./*"]
        }
    },
    "include": [
        "**/*.ts",
        "**/*.tsx",
        "babel.config.js",
        "metro.config.js",
        ".expo/types/**/*.ts",
        "expo-env.d.ts"
    ],
    "exclude": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "node_modules",
        "ios",
        "android",
        "expo-env.d.ts"
    ]
}
