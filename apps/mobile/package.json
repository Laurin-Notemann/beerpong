{
    "name": "mobile-app",
    "main": "expo-router/entry",
    "version": "1.0.93",
    "scripts": {
        "prestart": "cp ../.env.example .env",
        "start": "expo start",
        "android": "expo run:android",
        "ios": "expo run:ios",
        "test": "vitest .",
        "typecheck": "tsc --noEmit",
        "lint": "npm run lint:eslint && npm run typecheck",
        "build:ios:local": "npx eas build --local --platform ios",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "gen-types": "npx openapicmd typegen  ./api/generated/openapi.json > openapi/openapi.d.ts",
        "ci:format": "npm run format:check",
        "ci:lint": "npm run lint",
        "ci:test": "TEST_ENV=CI npm run test",
        "lint:eslint": "expo lint"
    },
    "dependencies": {
        "@expo/metro-runtime": "~58.0.10",
        "@expo/ui": "~58.0.11",
        "@expo/vector-icons": "^15.0.3",
        "@legendapp/list": "^3.6.0",
        "@openspacelabs/react-native-zoomable-view": "^2.4.2",
        "@react-native-async-storage/async-storage": "^2.1.0",
        "@react-native-community/datetimepicker": "9.2.1",
        "@react-native-community/netinfo": "12.0.1",
        "@sentry/react-native": "^8.29.0",
        "@tanstack/query-async-storage-persister": "^5.104.1",
        "@tanstack/react-query": "^5.104.1",
        "@tanstack/react-query-persist-client": "^5.104.1",
        "axios": "^1.20.0",
        "babel-preset-expo": "~58.0.0",
        "dayjs": "^1.11.23",
        "expo": "^58.0.2",
        "expo-application": "~58.0.3",
        "expo-blur": "~58.0.3",
        "expo-camera": "~58.0.7",
        "expo-clipboard": "~58.0.3",
        "expo-constants": "~58.0.9",
        "expo-dev-client": "~58.0.10",
        "expo-file-system": "~58.0.5",
        "expo-font": "~58.0.5",
        "expo-glass-effect": "~58.0.3",
        "expo-haptics": "~58.0.4",
        "expo-image": "~58.0.10",
        "expo-image-manipulator": "~58.0.11",
        "expo-image-picker": "~58.0.10",
        "expo-linking": "~58.0.10",
        "expo-notifications": "~58.0.11",
        "expo-router": "~58.0.12",
        "expo-secure-store": "~58.0.2",
        "expo-splash-screen": "~58.0.4",
        "expo-system-ui": "~58.0.5",
        "expo-task-manager": "~58.0.11",
        "expo-updates": "~58.0.13",
        "expo-video": "~58.0.8",
        "expo-web-browser": "~58.0.4",
        "expo-widgets": "~58.0.11",
        "openapi-client-axios": "^7.9.1",
        "react": "19.3.0",
        "react-native": "0.88.0-rc.3",
        "react-native-confirmation-code-field": "^9.0.0",
        "react-native-draggable-flatlist": "^4.0.1",
        "react-native-gesture-handler": "~3.2.1",
        "react-native-pager-view": "9.0.6",
        "react-native-reanimated": "4.7.0",
        "react-native-safe-area-context": "~5.9.1",
        "react-native-screens": "~4.28.0",
        "react-native-svg": "15.15.5",
        "react-native-worklets": "0.13.0",
        "sonner-native": "^0.27.0",
        "zustand": "^5.0.15"
    },
    "devDependencies": {
        "@babel/core": "^7.29.7",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/react": "^16.3.3",
        "@trivago/prettier-plugin-sort-imports": "^6.0.2",
        "@types/react": "~19.3.0",
        "eslint": "^10.12.0",
        "eslint-config-expo": "~58.0.4",
        "jsdom": "^30.1.1",
        "openapicmd": "^2.9.2",
        "prettier": "^3.9.9",
        "react-dom": "^19.3.0",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.71.0",
        "vite": "^8.3.2",
        "vitest": "^5.0.3"
    },
    "private": true,
    "expo": {
        "install": {
            "exclude": [
                "@sentry/react-native",
                "react-native-pager-view"
            ]
        }
    }
}
