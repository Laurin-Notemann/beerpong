        "react-dom": "^19.3.1",
        "sf-symbols-typescript": "^2.2.0",
        "typescript": "~7.0.2",
        "vite": "^8.3.5",
        "vitest": "^5.0.5"
    },
    "private": true,
    "expo": {
        "install": {
            "exclude": [
                "@sentry/react-native",
                "react-native-pager-view",
                "expo-video",
                "react-native-gesture-handler",
                "@react-native-async-storage/async-storage",
                "typescript"
            ]
        }
    }
