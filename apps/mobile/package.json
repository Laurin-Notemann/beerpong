{
    "name": "mobile-app",
    "main": "expo-router/entry",
    "version": "1.0.93",
    "scripts": {
        "prestart": "cp ../.env.example .env",
        "start": "expo start",
        "android": "expo run:android",
        "ios": "expo run:ios",
        "test": "vitest .",
        "typecheck": "tsc --noEmit",
        "build:ios:local": "pnpm dlx eas-cli build --local --platform ios",
        "gen-types": "openapi typegen ./api/generated/openapi.json > openapi/openapi.d.ts",
        "ci:test": "TEST_ENV=CI vitest ."
    },
    "dependencies": {
        "@expo/metro-runtime": "~58.0.15",
        "@expo/ui": "~58.0.25",
        "@expo/vector-icons": "^15.0.3",
        "@legendapp/list": "^3.6.0",
        "@openspacelabs/react-native-zoomable-view": "^2.4.2",
        "@react-native-async-storage/async-storage": "^3.1.1",
        "@react-native-community/datetimepicker": "9.2.2",
        "@react-native-community/netinfo": "12.0.1",
        "@sentry/react-native": "^8.29.0",
        "@tanstack/query-async-storage-persister": "^5.104.1",
        "@tanstack/react-query": "^5.104.1",
        "@tanstack/react-query-persist-client": "^5.104.1",
        "axios": "^1.20.0",
        "babel-preset-expo": "~58.0.22",
        "dayjs": "^1.11.23",
        "expo": "^58.0.21",
        "expo-application": "~58.0.3",
        "expo-blur": "~58.0.5",
        "expo-camera": "~58.0.14",
        "expo-clipboard": "~58.0.4",
        "expo-constants": "~58.0.14",
        "expo-dev-client": "~58.0.17",
        "expo-file-system": "~58.0.13",
        "expo-font": "~58.0.11",
        "expo-glass-effect": "~58.0.5",
        "expo-haptics": "~58.0.7",
        "expo-iap": "^5.8.2",
        "expo-image": "~58.0.18",
        "expo-image-manipulator": "~58.0.16",
        "expo-image-picker": "~58.0.10",
        "expo-keep-awake": "~58.0.3",
        "expo-linking": "~58.0.15",
        "expo-notifications": "~58.0.11",
        "expo-router": "~58.0.28",
        "expo-secure-store": "~58.0.2",
        "expo-splash-screen": "~58.0.12",
        "expo-system-ui": "~58.0.7",
        "expo-task-manager": "~58.0.12",
        "expo-updates": "~58.0.19",
